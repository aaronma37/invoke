#version 450
layout(local_size_x = 256) in;

struct Vertex {
    float px, py, pz;
    float nx, ny, nz;
    float cr, cg, cb;
};

struct Sample {
    float u, v, z_zero;
    float sdf;
    float r, g, b;
    float roughness, metallic;
};

layout(set = 0, binding = 0) buffer BaseVertices { Vertex base_verts[]; };
layout(set = 0, binding = 1) buffer BaseUVs { Sample base_uvs[]; };
layout(set = 0, binding = 2) buffer MorphVertices { Vertex morph_verts[]; };
layout(set = 0, binding = 3) buffer KanWeights { float coeffs[]; };

layout(push_constant) uniform PushConstants {
    float latents[16];
    uint vertex_count;
    uint in_dim;
    uint hidden_dim;
    uint out_dim;
    uint num_coeffs;
    uint layer1_offset;
    uint layer2_offset;
    uint l1_out_padded;
    uint l2_out_padded;
    float kmin;
    float kmax;
} pc;

vec4 kan_basis_all(float u) {
    float s2 = u * u;
    float s3 = s2 * u;
    float inv6 = 1.0 / 6.0;
    return vec4(
        inv6 * (1.0 - 3.0*u + 3.0*s2 - s3),
        inv6 * (4.0 - 6.0*s2 + 3.0*s3),
        inv6 * (1.0 + 3.0*u + 3.0*s2 - 3.0*s3),
        inv6 * s3
    );
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.vertex_count) return;

    // 1. Inputs
    float x[16]; 
    x[0] = base_uvs[idx].u;
    x[1] = base_uvs[idx].v;
    for(uint i=0; i < pc.in_dim-2; i++) x[i+2] = pc.latents[i];

    float h = (pc.kmax - pc.kmin) / float(pc.num_coeffs - 3);
    float inv_h = 1.0 / h;

    // 2. Layer 1 (In -> Hidden)
    float h1[256]; // Matches our hi-res hidden dim
    float l1_base_sum = 0.0;
    float inv_in_dim = 1.0 / float(pc.in_dim);

    // Precompute SiLU and Spline Spans for Layer 1
    for(uint i=0; i < pc.in_dim; i++) {
        float val = x[i];
        l1_base_sum += (val / (1.0 + exp(-val))) * inv_in_dim;
    }

    for(uint j=0; j < pc.hidden_dim; j++) {
        float spline_sum = 0.0;
        for(uint i=0; i < pc.in_dim; i++) {
            float val = x[i];
            float x_clamp = clamp(val, pc.kmin + 1e-6, pc.kmax - 1e-6);
            float span_float = (x_clamp - pc.kmin) * inv_h + 3.0;
            int span_idx = int(floor(span_float));
            float u = span_float - float(span_idx);
            
            vec4 b = kan_basis_all(u);
            int k_base = int(max(0, span_idx - 3));
            
            uint layer_coeffs_base = pc.layer1_offset + i * pc.num_coeffs * pc.l1_out_padded;
            spline_sum += b[0] * coeffs[layer_coeffs_base + (k_base + 0) * pc.l1_out_padded + j];
            spline_sum += b[1] * coeffs[layer_coeffs_base + (k_base + 1) * pc.l1_out_padded + j];
            spline_sum += b[2] * coeffs[layer_coeffs_base + (k_base + 2) * pc.l1_out_padded + j];
            spline_sum += b[3] * coeffs[layer_coeffs_base + (k_base + 3) * pc.l1_out_padded + j];
        }
        h1[j] = l1_base_sum + spline_sum;
    }

    // 3. Layer 2 (Hidden -> Out)
    float d[3] = {0, 0, 0};
    float l2_base_sum = 0.0;
    float inv_hidden_dim = 1.0 / float(pc.hidden_dim);

    for(uint i=0; i < pc.hidden_dim; i++) {
        float val = h1[i];
        l2_base_sum += (val / (1.0 + exp(-val))) * inv_hidden_dim;
    }

    for(uint j=0; j < pc.out_dim; j++) {
        float spline_sum = 0.0;
        for(uint i=0; i < pc.hidden_dim; i++) {
            float val = h1[i];
            float x_clamp = clamp(val, pc.kmin + 1e-6, pc.kmax - 1e-6);
            float span_float = (x_clamp - pc.kmin) * inv_h + 3.0;
            int span_idx = int(floor(span_float));
            float u = span_float - float(span_idx);
            
            vec4 b = kan_basis_all(u);
            int k_base = int(max(0, span_idx - 3));
            
            uint layer_coeffs_base = pc.layer2_offset + i * pc.num_coeffs * pc.l2_out_padded;
            spline_sum += b[0] * coeffs[layer_coeffs_base + (k_base + 0) * pc.l2_out_padded + j];
            spline_sum += b[1] * coeffs[layer_coeffs_base + (k_base + 1) * pc.l2_out_padded + j];
            spline_sum += b[2] * coeffs[layer_coeffs_base + (k_base + 2) * pc.l2_out_padded + j];
            spline_sum += b[3] * coeffs[layer_coeffs_base + (k_base + 3) * pc.l2_out_padded + j];
        }
        d[j] = l2_base_sum + spline_sum;
    }

    // 4. Apply Displacement
    morph_verts[idx].px = base_verts[idx].px + d[0];
    morph_verts[idx].py = base_verts[idx].py + d[1];
    morph_verts[idx].pz = base_verts[idx].pz + d[2];
    
    morph_verts[idx].nx = base_verts[idx].nx;
    morph_verts[idx].ny = base_verts[idx].ny;
    morph_verts[idx].nz = base_verts[idx].nz;
    morph_verts[idx].cr = base_verts[idx].cr;
    morph_verts[idx].cg = base_verts[idx].cg;
    morph_verts[idx].cb = base_verts[idx].cb;
}
