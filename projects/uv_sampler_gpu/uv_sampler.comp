#version 450
layout(local_size_x = 256) in;

struct Triangle {
    vec4 v0, v1, v2, unused;
};

struct PointSample {
    float u, v, z_zero, sdf, r, g, b, roughness, metallic;
};

layout(push_constant) uniform PushConstants {
    uint target_tri_count;
    uint base_vert_count;
} pc;

layout(std430, binding = 0) buffer TargetTriangles { Triangle target_tris[]; };
layout(std430, binding = 1) buffer BaseVertices { vec4 base_pos[]; };
layout(std430, binding = 2) buffer BaseNormals { vec4 base_norms[]; };
layout(std430, binding = 3) buffer BaseUVs { vec2 base_uvs[]; };
layout(std430, binding = 4) buffer OutSamples { PointSample samples[]; };

bool intersectTriangle(vec3 orig, vec3 dir, Triangle tri, out float t, out float u, out float v) {
    vec3 v0 = tri.v0.xyz;
    vec3 v1 = tri.v1.xyz;
    vec3 v2 = tri.v2.xyz;
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 pvec = cross(dir, edge2);
    float det = dot(edge1, pvec);

    // Allow hits from both sides for displacement sampling
    if (abs(det) < 1e-8) return false;
    float invDet = 1.0 / det;
    vec3 tvec = orig - v0;
    u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) return false;
    vec3 qvec = cross(tvec, edge1);
    v = dot(dir, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0) return false;
    t = dot(edge2, qvec) * invDet;
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.base_vert_count) return;

    vec3 origin = base_pos[idx].xyz;
    vec3 dir = normalize(base_norms[idx].xyz);
    
    float min_t = 1e30;
    bool hit = false;
    vec3 hit_pos = vec3(0);

    for (uint i = 0; i < pc.target_tri_count; i++) {
        float t, u, v;
        // Test Forward
        if (intersectTriangle(origin, dir, target_tris[i], t, u, v)) {
            if (t > 0.0 && t < min_t) {
                min_t = t;
                hit = true;
                hit_pos = origin + dir * t;
            }
        }
        // Test Backward (for shrinking/hollow morphs)
        if (intersectTriangle(origin, -dir, target_tris[i], t, u, v)) {
            if (t > 0.0 && t < min_t) {
                min_t = t;
                hit = true;
                hit_pos = origin - dir * t;
            }
        }
    }

    samples[idx].u = base_uvs[idx].x;
    samples[idx].v = base_uvs[idx].y;
    samples[idx].z_zero = 0.0;

    if (hit) {
        vec3 displacement = hit_pos - origin;
        samples[idx].sdf = length(displacement) * (dot(displacement, dir) > 0.0 ? 1.0 : -1.0);
        samples[idx].r = displacement.x;
        samples[idx].g = displacement.y;
        samples[idx].b = displacement.z;
    } else {
        samples[idx].sdf = 0.0;
        samples[idx].r = 0.0;
        samples[idx].g = 0.0;
        samples[idx].b = 0.0;
    }
}
